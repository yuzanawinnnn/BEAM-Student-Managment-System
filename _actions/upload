<?php
$error = $_FILES['photo']['error'];
$tmp = $_FILES['photo']['tmp_name'];
$type = $_FILES['photo']['type'];

//if error exists, redirect to profile.php with error url query
if($error) {
header('location: ../profile.php?error=file');
exit(); // stop the process
}

// check if the type is jpeg or png, if yes, save the photo to photo folder
if($type === "image/jpeg" or $type === "image/png") {
move_uploaded_file($tmp, "photos/profile.jpg");
header('location: ../profile.php');
} else { // if not, redirect to profile.php with error url query
header('location: ../profile.php?error=type');
}
